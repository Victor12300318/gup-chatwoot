PORT=3000
HOST_PORT=3006

# Conexão PostgreSQL (Substitua pela URL do Easypanel)
DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco?schema=public"

# Conexão Redis (BullMQ - opcional se usar filas)
REDIS_URL="redis://default:senha@host:6379"

# Chave secreta de autenticação do painel admin
ADMIN_API_KEY="sua_chave_secreta"
